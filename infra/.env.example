# Copy to .env and adjust. The daemon mounts CLAUDE_DIR read-only.

# Absolute path to this machine's Claude Code directory.
#   Windows (Docker Desktop): C:\Users\<you>\.claude   (use forward slashes)
#   macOS / Linux:            /home/<you>/.claude
CLAUDE_DIR=C:/Users/you/.claude

# Shared bearer token — the daemon and the API must match. Change this.
CONTINUUM_TOKEN=change-me-to-something-long-and-random

# Postgres password.
POSTGRES_PASSWORD=continuum

# A stable name for this computer (shows up in the UI).
MACHINE_NAME=desktop

# Self-hosted embedding model pulled into Ollama. Must be 768-dim to match the schema
# (nomic-embed-text). To use a different width, also update EmbeddingConfig.Dimensions
# + a migration for the Memories.Embedding column.
EMBEDDING_MODEL=nomic-embed-text
