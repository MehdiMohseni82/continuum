# Copy to .env and adjust. The daemon mounts CLAUDE_DIR read-only.

# Absolute path to this machine's Claude Code directory.
#   Windows (Docker Desktop): C:\Users\<you>\.claude   (use forward slashes)
#   macOS / Linux:            /home/<you>/.claude
CLAUDE_DIR=C:/Users/you/.claude

# Shared bearer token — the daemon and the API must match. Change this.
CONTINUUM_TOKEN=change-me-to-something-long-and-random

# Postgres password.
POSTGRES_PASSWORD=continuum

# A stable name for this computer (shows up in the UI).
MACHINE_NAME=desktop

# Self-hosted embedding model pulled into Ollama. Must be 768-dim to match the schema
# (nomic-embed-text). To use a different width, also update EmbeddingConfig.Dimensions
# + a migration for the Memories.Embedding column.
EMBEDDING_MODEL=nomic-embed-text

# Claude API key. Optional. Leave it unset and the server behaves exactly as before: generation stays
# on self-hosted Ollama and nothing leaves the network.
#
# Setting it enables two things that need an external model — room drafting (which prefers Claude over
# the local model, because a demanding room brief is where a 7B reads thin) and the server-side room
# agent, which has never been able to run without it.
#
# Note what this sends: the specification you paste, plus — when you ground a draft in a project — the
# memories and transcript excerpts retrieved for it.
ANTHROPIC_API_KEY=

# Which Claude model the server uses. Only read when ANTHROPIC_API_KEY is set.
SERVER_AGENT_MODEL=claude-opus-5

# The autonomous room loop: agents take turns unattended, with no human in the room. Off, and worth
# leaving off — an unattended loop is what once ran two agents for 48 hours with nothing to show. The
# "Lead" button drives a turn on demand without this.
SERVER_AGENTS_ENABLED=false
