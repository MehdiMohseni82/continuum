<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The `continuum` command. Replaces hooks/relay/*.ps1, which was Windows-only in ways that could
    not be patched around: literal `curl.exe`, `$env:USERPROFILE`, and a config path built with
    backslashes. It also reimplemented RoomTurn's done/pass logic in PowerShell, free to drift from
    the C# the daemon uses.

    References Continuum.Client — which has no package dependencies and owns Rooms/RoomTurn.cs — so
    the relay and the daemon decide "is this turn over" with the same code.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>continuum</AssemblyName>
    <RootNamespace>Continuum.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Ships to user machines; a newer installed runtime must not refuse to launch it. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Continuum.Client\Continuum.Client.csproj" />
  </ItemGroup>

</Project>
