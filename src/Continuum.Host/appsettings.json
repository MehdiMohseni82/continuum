{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=continuum;Username=continuum;Password=continuum"
  },
  "Continuum": {
    "Token": "dev-local-token-change-me"
  },
  "Embeddings": {
    "Provider": "ollama",
    "Endpoint": "http://localhost:11434",
    "Model": "nomic-embed-text",
    "ApiKey": ""
  },
  "Maintenance": {
    "DecayIntervalHours": 6,
    "RetentionDays": 0
  },
  "Generation": {
    "Endpoint": "http://localhost:11434",
    "Model": "qwen2.5:7b-instruct"
  },
  "ServerAgents": {
    "Enabled": false,
    "ApiKey": "",
    "Model": "claude-opus-5",
    "IntervalSeconds": 20,
    "MaxTokens": 1024,
    "ContextLines": 12,
    "Agents": []
  },
  "Extraction": {
    "Enabled": true,
    "IntervalMinutes": 3,
    "PerCycle": 3,
    "MinEvents": 12,
    "IdleMinutes": 10
  },
  "Digest": {
    "Enabled": true,
    "IntervalHours": 24,
    "MinGapHours": 20
  },
  "Backups": {
    "Directory": ""
  },
  "Auth": {
    "AllowLegacyToken": true,
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminName": "Admin",
    "AuthSecret": ""
  }
}
